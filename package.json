{
  "name": "doctor-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.29.0",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "postinstall": "pnpm --filter @doctor-tracker/shared build",
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter @doctor-tracker/api seed",
    "db:indexes": "pnpm --filter @doctor-tracker/api db:indexes"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
