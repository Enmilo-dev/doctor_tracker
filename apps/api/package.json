{
  "name": "@doctor-tracker/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/scripts/sync-indexes.js && node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:indexes": "tsx --env-file-if-exists=.env src/scripts/sync-indexes.ts"
  },
  "dependencies": {
    "@doctor-tracker/shared": "workspace:*",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "jose": "6.2.18",
    "mongoose": "9.13.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "tsx": "4.23.15"
  }
}
